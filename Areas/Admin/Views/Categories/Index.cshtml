@model IEnumerable<Đề_tài.Models.Category>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

@* Dùng chung bộ màu LEGO với phần Sản phẩm (file này nằm trong thư mục Products) *@
@Html.Partial("~/Areas/Admin/Views/Products/PVProductTheme.cshtml")

<style>
    /* Khung trang: lề 35px giống header, rộng hết màn hình */
    .list-page {
        padding: 30px 35px 40px 35px;
    }

    /* Thanh tiêu đề: chữ bên trái, nút tạo mới bên phải */
    .title-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .product-section .btn-create {
        padding: 8px 20px;
        background-color: #FFD400;
        border: 2px solid #FFD400;
        color: #1A1A1A;
        font-size: 1rem;
        font-weight: 700;
    }

        .product-section .btn-create:hover,
        .product-section .btn-create:focus {
            background-color: #FFFFFF;
            border-color: #FFFFFF;
            color: var(--title-bg);
        }

    /* ---------------- Bảng ---------------- */
    .category-table {
        margin-bottom: 0;
        border-color: var(--line);
    }

        .category-table.table > tbody {
            border-top-color: var(--line);
        }

        .category-table > thead > tr > th {
            background-color: var(--head-bg);
            color: var(--head-fg);
            white-space: nowrap;
            vertical-align: middle;
        }

        .category-table > tbody > tr > td {
            background-color: var(--row-bg);
            vertical-align: middle;
        }

        .category-table > tbody > tr:nth-child(even) > td {
            background-color: var(--row-alt);
        }

        .category-table > tbody > tr:hover > td {
            box-shadow: inset 0 0 0 9999px rgba(0, 0, 0, 0.05);
        }

        .category-table .col-name {
            font-size: 1.15rem;
            font-weight: 600;
        }

        /* Chỉ áp dụng cho ảnh trong bảng, không ảnh hưởng logo ở header */
        .category-table img {
            display: block;
            width: 140px;
            height: 140px;
            object-fit: cover;
            border-radius: 50%;
        }

        .category-table .col-actions {
            white-space: nowrap;
        }

    .action-buttons {
        display: flex;
        flex-wrap: nowrap;
        gap: 8px;
    }
</style>

<div class="list-page">
    <div class="product-section theme-lego">
        <div class="page-title title-bar">
            <span>DANH MỤC</span>
            @Html.ActionLink("+ Tạo danh mục", "Create", null, new { @class = "btn btn-create" })
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table category-table">
                    <thead>
                        <tr>
                            <th style="width: 38%;">Tên danh mục</th>
                            <th style="width: 27%;">Ảnh danh mục</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="col-name">
                                    @Html.DisplayFor(modelItem => item.CategoryName)
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.CategoryImage))
                                    {
                                        @* nếu để bình thường Html.DisplayFor thì trình duyệt không hiểu dấu ~ *@
                                        <img src="@Url.Content(item.CategoryImage)" alt="@item.CategoryName" />
                                    }
                                    else
                                    {
                                        <span>Không có ảnh</span>
                                    }
                                </td>
                                <td class="col-actions">
                                    <div class="action-buttons">
                                        @Html.ActionLink("Sửa", "Edit", new { id = item.CategoryID }, new { @class = "btn btn-primary btn-sm" })
                                        @Html.ActionLink("Chi tiết", "Details", new { id = item.CategoryID }, new { @class = "btn btn-primary btn-sm" })
                                        @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID }, new { @class = "btn btn-primary btn-sm" })
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p style="padding: 20px 0;">Chưa có danh mục nào.</p>
        }
    </div>
</div>
