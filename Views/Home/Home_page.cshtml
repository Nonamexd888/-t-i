@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Trang chủ LEGO";
}

<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Rubik+Bubbles&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Michroma&family=Nabla:EDPT,EHLT@46,0&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bitcount+Ink:wght@100..900&display=swap" rel="stylesheet">
    <style>
        .banner {
            /*min-height: 400px;*/
            background-color: #b50505;
        }
            .banner img {
                display: block;
                width: 100%;
                height: 400px;
                object-fit: cover;
            }

        #slogan p {
            font-family: "Rubik Bubbles", system-ui;
            font-weight: 400;
            font-style: normal;
            color: white;
            font-size: 50px;
        }



        .category {
            display: flex; /* Xếp ngang */
            justify-content: center;
            gap: 65px;
            background: #1a1a1a;
            height: 310px;
            align-items: center;
        }

        .category-card {
            position: relative; /* Để đặt chữ lên ảnh */
            flex: 0 0 180px; /* Mỗi thẻ rộng 200px, không co giãn */
            text-decoration: none; /* Bỏ gạch chân link */
            color: white;
            border-radius: 8px;
            overflow: hidden;
            transition: transform 0.3s;
        }

            .category-card:hover {
                transform: scale(1.15); /* Phóng to khi hover */
                box-shadow: 0 10px 25px rgba(255, 255, 255, 0.25);
            }

            .category-card img {
                width: 100%;
                height: 250px;
                object-fit: contain; /* Ảnh phủ kín, không méo */
            }

        .category-title {
            position: absolute; /* Đặt chữ lên ảnh */
            top: 20px;
            left: 40px;
            font-size: 20px;
            font-weight: bold;
            text-shadow: 0 2px 4px rgba(0,0,0,0.5); /* Bóng chữ */
        }


        .content .movingbutton {
            margin: 20px;
            border-radius: 180px;
            width: 80px;
            height: 80px;
            font-size: 30px;
            color: black;
            background-color: white;
            border: 5px solid black;
            cursor: pointer;
            transition: all 0.15s;
        }

            .content .movingbutton:active {
                background-color: black;
                color: white;
            }

        .slide {
            display: none;
        }

            .slide.active {
                display: flex;
                gap: 100px;
                justify-content: center;
                animation: slideIn 0.5s ease;
            }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(100px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .product {
            position: relative;
            display: flex;
            justify-content: space-between;
            flex-direction: column;
            border: 1px solid #faeeed;
            background-color: white;
            box-shadow: 5px 5px 10px rgba(10, 10, 10,0.2);
            width: 300px;
        }

        .product_img {
            justify-content: flex-start;
            height: 350px;
            object-fit: contain;
        }

        .product button {
            background-color: #f47d20;
            border-radius: 50px;
            width: 100%;
            border: none;
            height: 50px;
            font-size: 15px;
            font-weight: bold;
        }


        .product .price {
            font-family: "Bitcount Ink", system-ui;
            font-optical-sizing: auto;
            font-weight: 100;
            font-style: normal;
            font-variation-settings: "slnt" 0, "CRSV" 0.5, "ELSH" 0, "ELXP" 0, "SZP1" 0, "SZP2" 0, "XPN1" 0, "XPN2" 0, "YPN1" 0, "YPN2" 0;
            font-size: 50px;
        }

        .product .name {
            font-family: "Michroma", sans-serif;
            font-weight: bold;
            font-style: normal;
            font-size: 20px;
        }


        /*responsive cho điện thoại*/
        @@media (max-width: 768px) {
            /* Header */
            .header02 {
                flex-wrap: wrap;
                padding: 10px;
                gap: 10px;
            }

            .header02_content01 {
                margin-right: 0;
                gap: 10px;
            }

            .header02_content03 {
                margin-left: 10px;
            }

            #search {
                width: 110px;
            }


            .banner img {
                min-height: 200px;
                object-fit: cover;
                display: block;
            }

            #slogan p {
                font-size: 24px;
            }
            /* Category: cho phép xuống dòng */
            .category {
                flex-wrap: wrap;
                padding: 10px 0;
            }

            .category-card {
                flex: 0 0 140px;
            }

                .category-card img {
                    height: 180px;
                }

                .category-card:hover {
                    transform: none;
                }

            .category-title {
                font-size: 16px;
                left: 15px;
            }
            /* Slide sản phẩm: xuống dòng, 2 thẻ mỗi hàng */
            .slide.active {
                flex-wrap: wrap;
                gap: 16px;
            }

            .product {
                width: 160px;
            }

            .product_img {
                width: 100%;
                height: 200px;
                object-fit: contain;
            }

            .product .name {
                font-size: 13px;
            }

            .product .price {
                font-size: 28px;
            }
            /* Nút điều hướng nhỏ lại */
            .content .movingbutton {
                width: 50px;
                height: 50px;
                font-size: 20px;
                margin: 10px;
                border-width: 3px;
            }
            /* Footer: xếp dọc */
            .footer_inner {
                flex-direction: column;
                gap: 30px;
                padding: 0 20px;
                box-sizing: border-box;
            }
        }
    </style>
</head>

