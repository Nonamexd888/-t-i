@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/LegoHome/Home.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Rubik+Bubbles&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Michroma&family=Nabla:EDPT,EHLT@46,0&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bitcount+Ink:wght@100..900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: Arial,'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
        }

        .container {
            display: grid;
            background-color: grey;
            grid-template-areas:
                "header"
                "header02"
                "banner"
                "category"
                "content"
                "footer";
            grid-template-columns: 1fr;
        }



        .header {
            grid-area: header;
            background-color: #f7f7f7;
        }

        .header_container {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            margin: 10px;
        }

        .header02 {
            grid-area: header02;
            display: flex;
            min-height: 50px;
            align-items: center;
            background-color: #ffd400;
        }

        .header02_content01 {
            display: flex;
            gap: 20px;
            align-items: center;
            margin-right: 50%;
        }

            .header02_content01 a {
                text-decoration: none;
                color: black;
            }

                .header02_content01 a:hover {
                    text-decoration: 2px underline;
                }

            .header02_content01 button {
                border-radius: 5px;
                color: red;
                padding: 10px;
                width: 75px;
                background-color: white;
                font-weight: normal;
            }

                .header02_content01 button:hover {
                    background-color: black;
                    color: white;
                    align-items: center;
                }

        .banner {
            grid-area: banner;
        }

        .category {
            grid-area: category;
        }

        .footer {
            grid-area: footer;
        }

        button {
            border: none;
            background-color: #d1e8ff;
            padding: 15px;
            text-align: center;
            font-weight: bold;
            font-size: 13.5px;
            border-radius: 25px;
            transition: all 0.2s;
        }

        .header button:hover {
            background-color: #8497ab;
        }

        #header_signIn {
            text-decoration: none;
            color: black;
            padding: 15px;
            text-align: center;
            transition: all 0.5s;
        }

            #header_signIn:hover {
                background-color: #ffd400;
                border-radius: 25px;
            }

        .header02_content02 {
            display: flex;
            align-items: center;
            margin-right: 0px;
            background-color: white;
            height: 30px;
            border-radius: 25px;
            transition: all 0.5s;
        }

            .header02_content02:hover {
                box-shadow: 2px 2px 5px rgba(0,0,0,0.5);
            }

        #search {
            border-radius: 25px;
            outline: none;
            width: 200px;
            border: none;
        }

        .header02_content03 {
            display: flex;
            align-items: center;
            margin-left: 30px;
            gap: 10px;
        }

        .banner {
            position: relative;
            display: flex;
            justify-content: space-between;
            align-items: center;
            min-height: 400px;
            background-color: #b50505;
        }

        #banner_img img {
            width: 100%;
            height: 400px;
        }

        #slogan p {
            font-family: "Rubik Bubbles", system-ui;
            font-weight: 400;
            font-style: normal;
            color: white;
            font-size: 50px;
        }

        #banner02 img {
            width: 100%;
            height: 400px;
        }

        .category {
            display: flex; /* Xếp ngang */
            justify-content: center;
            gap: 16px;
            background: #1a1a1a;
        }

        .category-card {
            position: relative; /* Để đặt chữ lên ảnh */
            flex: 0 0 200px; /* Mỗi thẻ rộng 200px, không co giãn */
            text-decoration: none; /* Bỏ gạch chân link */
            color: white;
            border-radius: 8px;
            overflow: hidden;
            transition: transform 0.3s;
        }

            .category-card:hover {
                transform: scale(1.15); /* Phóng to khi hover */
            }

            .category-card img {
                width: 100%;
                height: 250px;
                object-fit: contain; /* Ảnh phủ kín, không méo */
            }

        .category-title {
            position: absolute; /* Đặt chữ lên ảnh */
            top: 20px;
            left: 40px;
            font-size: 20px;
            font-weight: bold;
            text-shadow: 0 2px 4px rgba(0,0,0,0.5); /* Bóng chữ */
        }

        .content {
            position: relative;
            min-height: 500px;
            background-color: white;
        }

            .content .movingbutton {
                margin: 20px;
                border-radius: 180px;
                width: 80px;
                height: 80px;
                font-size: 30px;
                color: black;
                background-color: white;
                border: 5px solid black;
                cursor: pointer;
                transition: all 0.15s;
            }

                .content .movingbutton:active {
                    background-color: black;
                    color: white;
                }

        .slide {
            display: none;
        }

            .slide.active {
                display: flex;
                gap: 100px;
                justify-content: center;
                animation: slideIn 0.5s ease;
            }
            
            @@keyframes slideIn {
                from {
                    opacity: 0;
                    transform: translateX(100px);
                }
                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

        .product {
            position: relative;
            display: flex;
            justify-content: space-between;
            flex-direction: column;
            border: 1px solid #faeeed;
            background-color: white;
            box-shadow: 5px 5px 10px rgba(10, 10, 10,0.2);
            width: 300px;
        }

        .product_img {
            justify-content: flex-start;
        }

        .product button {
            background-color: #f47d20;
            border-radius: 50px;
            width: 100%;
        }


        .product .price {
            font-family: "Bitcount Ink", system-ui;
            font-optical-sizing: auto;
            font-weight:100;
            font-style: normal;
            font-variation-settings: "slnt" 0, "CRSV" 0.5, "ELSH" 0, "ELXP" 0, "SZP1" 0, "SZP2" 0, "XPN1" 0, "XPN2" 0, "YPN1" 0, "YPN2" 0;
            font-size: 50px;
        }

        .product .name {
            font-family: "Michroma", sans-serif;
            font-weight: bold;
            font-style: normal;
            font-size: 20px;
        }
        .footer {
            grid-area: footer;
            background-color: #141414;
            color: white;
            padding: 50px 0;
        }

        .footer_inner {
            display: flex;
            justify-content: center;
            gap: 80px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .footer_logo img {
            width: 120px;
            height: 120px;
        }

        .footer_col {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

            .footer_col h3 {
                margin: 0 0 10px 0;
                font-size: 24px;
            }

            .footer_col a {
                color: white;
                text-decoration: none;
                font-size: 16px;
            }

                .footer_col a:hover {
                    text-decoration: underline;
                }
             /*responsive cho điện thoại*/
        @@media (max-width: 768px) {

            /* Header */
            .header02 {
                flex-wrap: wrap;
                padding: 10px;
                gap: 10px;
            }

            .header02_content01 {
                margin-right: 0;
                gap: 10px;
            }

            .header02_content03 {
                margin-left: 10px;
            }

            #search {
                width: 110px;
            }

            /* Banner: ẩn ảnh hai bên, chỉ giữ slogan */
            #banner_img,
            #banner02 {
                display: none;
            }

            .banner {
                min-height: 200px;
                justify-content: center;
                text-align: center;
                padding: 20px;
            }

            #slogan p {
                font-size: 24px;
            }

            /* Category: cho phép xuống dòng */
            .category {
                flex-wrap: wrap;
                padding: 10px 0;
            }

            .category-card {
                flex: 0 0 140px;
            }

                .category-card img {
                    height: 180px;
                }

                .category-card:hover {
                    transform: none;
                }

            .category-title {
                font-size: 16px;
                left: 15px;
            }

            /* Slide sản phẩm: xuống dòng, 2 thẻ mỗi hàng */
            .slide.active {
                flex-wrap: wrap;
                gap: 16px;
            }

            .product {
                width: 160px;
            }

            .product_img {
                width: 100%;
            }

            .product .name {
                font-size: 13px;
            }

            .product .price {
                font-size: 28px;
            }

            /* Nút điều hướng nhỏ lại */
            .content .movingbutton {
                width: 50px;
                height: 50px;
                font-size: 20px;
                margin: 10px;
                border-width: 3px;
            }

            /* Footer: xếp dọc */
            .footer_inner {
                flex-direction: column;
                gap: 30px;
                padding: 0 20px;
                box-sizing: border-box;
            }
        }
    </style>

</head>
<body>
    <div class="container">
        <div class="header">
            <div class="header_container">
                <button> PLAY ZONE</button>
                <a href="http://localhost:52291/Sign/Dangnhap" id="header_signIn">
                    <img src="~/Content/Img_HomePage/legoHeadIcon.jpg" alt="legoHeadIcon" style="width:20px; height: 20px; margin-right:13px;" />Sign in
                </a>
            </div>
        </div>
        
        <div class="header02">
            <div class="header02_content01">
                <img src="~/Content/Img_HomePage/LEGO_logo.jpg" style="height:55px;width:55px;" />
                <a href="#">SHOP</a>
