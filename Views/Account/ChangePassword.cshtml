@model Đề_tài.Models.ViewModel.Account.ChangePasswordVM

@{
    ViewBag.Title = "Đổi mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    /* --- 1. NỀN VÀNG LEGO & TRANG TRÍ --- */
    .password-page {
        min-height: 80vh;
        padding: 50px 20px;
        background: linear-gradient(135deg, #FFF9C4 0%, #FFD54F 100%);
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Montserrat', sans-serif;
        position: relative;
        overflow: hidden;
    }

        .password-page::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: radial-gradient(#E6A800 1px, transparent 1px);
            background-size: 20px 20px;
            opacity: 0.1;
            z-index: 0;
        }

    /* --- 2. KHUNG KÍNH MỜ --- */
    .password-container {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 480px;
        padding: 45px 40px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border: 3px solid #E6A800;
        border-radius: 24px;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15), inset 0 0 0 4px rgba(255, 255, 255, 0.5);
        animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(60px) scale(0.95);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* --- 3. TIÊU ĐỀ & LOGO --- */
    .logo-wrapper {
        text-align: center;
        margin-bottom: 20px;
    }

    .logo {
        width: 70px;
        filter: drop-shadow(0 5px 10px rgba(0,0,0,0.2));
    }

    h1.pw-title {
        color: #222;
        text-align: center;
        font-size: 24px;
        margin-bottom: 5px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    h4.pw-subtitle {
        color: #666;
        text-align: center;
        font-size: 13px;
        margin-bottom: 30px;
        font-weight: 600;
        letter-spacing: 1px;
    }

    /* --- 4. THÔNG BÁO THÀNH CÔNG MÀU XANH LÁ --- */
    .alert-success-custom {
        background-color: #d4edda;
        color: #155724;
        border: 2px solid #c3e6cb;
        border-radius: 10px;
        padding: 15px;
        font-weight: 700;
        font-size: 14px;
        text-align: center;
        box-shadow: 0 4px 10px rgba(0, 128, 0, 0.1);
        animation: fadeIn 0.5s ease;
        margin-bottom: 20px;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* --- 5. FORM & INPUT --- */
    .reg-field {
        margin-bottom: 20px;
    }

        .reg-field label {
            color: #444;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
            display: block;
        }

        .reg-field input {
            width: 100%;
            padding: 14px 18px;
            background: #f9f9f9;
            border: 2px solid #eee;
            border-radius: 12px;
            color: #222;
            font-size: 14px;
            font-weight: 600;
            outline: none;
            transition: all 0.3s ease;
            box-sizing: border-box;
        }

            .reg-field input:focus {
                background: #fff;
                border-color: #FFCF00;
                box-shadow: 0 0 10px rgba(255, 207, 0, 0.3);
            }

    /* Hiệu ứng hiện/ẩn mật khẩu */
    .pw-wrap {
        position: relative;
    }

        .pw-wrap input {
            padding-right: 54px;
        }

    .toggle-eye {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        padding: 4px 8px;
        border: none;
        background: transparent;
        font-size: 18px;
        line-height: 1;
        cursor: pointer;
    }

    /* --- 6. NÚT BẤM 3D LEGO --- */
    button.btn-save {
        width: 100%;
        padding: 16px;
        background-color: #E60101;
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 800;
        cursor: pointer;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        position: relative;
        box-shadow: 0 6px 0 #8a0000, 0 10px 15px rgba(0,0,0,0.3);
        transition: all 0.1s ease;
        margin-top: 10px;
    }

        button.btn-save:hover {
            background-color: #ff1a1a;
            transform: translateY(-2px);
            box-shadow: 0 8px 0 #8a0000, 0 15px 20px rgba(0,0,0,0.4);
        }

        button.btn-save:active {
            transform: translateY(6px);
            box-shadow: 0 0px 0 #8a0000, 0 2px 5px rgba(0,0,0,0.3);
        }

    .btn-back {
        display: block;
        text-align: center;
        margin-top: 20px;
        color: #666;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-back:hover {
            color: #E60101;
            text-decoration: underline;
        }

    .text-danger {
        color: #E60101 !important;
        font-size: 12px;
        font-weight: 600;
        margin-top: 5px;
        display: block;
    }
</style>

<div class="password-page">
    <div class="password-container">
        <div class="logo-wrapper">
            <img src="https://upload.wikimedia.org/wikipedia/commons/2/24/LEGO_logo.svg" alt="LEGO" class="logo">
        </div>

        <h1 class="pw-title">Đổi mật khẩu</h1>
        <h4 class="pw-subtitle">Bảo vệ tài khoản của bạn</h4>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert-success-custom">@ViewBag.SuccessMessage</div>
        }

        @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <!-- Mật khẩu cũ -->
            <div class="reg-field">
                <label for="OldPassword">Mật khẩu hiện tại</label>
                <div class="pw-wrap">
                    @Html.EditorFor(m => m.OldPassword, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập mật khẩu hiện tại", id = "OldPassword" } })
                    <button type="button" class="toggle-eye" onclick="togglePassword('OldPassword', this)" tabindex="-1" aria-label="Hiện hoặc ẩn mật khẩu">👁️</button>
                </div>
                @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-danger" })
            </div>

            <!-- Mật khẩu mới -->
            <div class="reg-field">
                <label for="NewPassword">Mật khẩu mới</label>
                <div class="pw-wrap">
                    @Html.EditorFor(m => m.NewPassword, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập mật khẩu mới", id = "NewPassword" } })
                    <button type="button" class="toggle-eye" onclick="togglePassword('NewPassword', this)" tabindex="-1" aria-label="Hiện hoặc ẩn mật khẩu">👁️</button>
                </div>
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
            </div>

            <!-- Xác nhận mật khẩu mới -->
            <div class="reg-field">
                <label for="ConfirmNewPassword">Xác nhận mật khẩu mới</label>
                <div class="pw-wrap">
                    @Html.EditorFor(m => m.ConfirmedNewPassword, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập lại mật khẩu mới", id = "ConfirmNewPassword" } })
                    <button type="button" class="toggle-eye" onclick="togglePassword('ConfirmNewPassword', this)" tabindex="-1" aria-label="Hiện hoặc ẩn mật khẩu">👁️</button>
                </div>
                @Html.ValidationMessageFor(m => m.ConfirmedNewPassword, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn-save">Xác nhận đổi mật khẩu</button>

            <a href="@Url.Action("UserProfile", "Account")" class="btn-back">&larr; Quay lại trang cá nhân</a>
        }
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword(inputID, button) {
            var input = document.getElementById(inputID);
            if (input.type === 'password') {
                input.type = 'text';
                button.innerHTML = '🙈';
            } else {
                input.type = 'password';
                button.innerHTML = '👁️';
            }
        }
    </script>
}