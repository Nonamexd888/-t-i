                    <p class="name">Executor Super Star Destroyer<sup>TM</sup></p>
                    <p class="price">$799.99</p>


                    <button class="AddToCart">Add to bag</button>
                </div>
                <div class="product">
                    <img class="product_img" src="https://www.lego.com/cdn/cs/set/assets/blt7c82306f195e1ab9/blt443c77033df96caf-40926_Prod_en-gb.png?format=webply&fit=bounds&quality=90&width=250&height=250&dpr=1.5" />

                    <p class="name">SEGA GENESIS<sup>TM</sup> CONSOLE</p>
