    function showError(key, mess) {
        document.getElementById(key + "_error").innerHTML = mess;
    }

    function kiemTraVaDatHang() {

        let flag = true;
        // var gio = layGioHang();
        // if (gio.length === 0) {
        //     alert("Giỏ hàng của bạn đang trống!");
        //     flag = false;
        //     return flag;
        // }
        //Reset thông báo lỗi về rỗng toàn bộ
        showError("txtHoTen", "");
        showError("txtSoDienThoai", "");
        showError("txtEmail", "");
        showError("txtDiaChi", "");

        var hoTen = document.getElementById("txtHoTen").value.trim();
        var sdt = document.getElementById("txtSoDienThoai").value.trim();
        var email = document.getElementById("txtEmail").value.trim();
        var diaChi = document.getElementById("txtDiaChi").value.trim();
        var ghiChu = document.getElementById("txtGhiChu").value.trim();

        if (hoTen.length <= 0) {
            flag = false;
            showError("txtHoTen", "Vui lòng nhập tên!");

        }

        var phoneRegex = /^[0-9]{10}$/;
        if (!phoneRegex.test(sdt)) {
            showError("txtSoDienThoai", "Vui lòng nhập số điện thoại 10 số");
            flag = false;

        }

        const emailForm = /^[a-zA-z0-9._]+@@gmail.com$/;
        if (!emailForm.test(email)) {
            showError("txtEmail", "Vui lòng nhập email đúng định dạng");
            flag = false;

        }
        if (email.length <= 10) {
            showError("txtEmail", "Vui lòng nhập email trên 10 kí tự");
            flag = false;
        }

        if (diaChi.length === 0) {
            showError("txtDiaChi", "Vui lòng nhập địa chỉ");
            flag = false;
        }
        return flag;

    }

