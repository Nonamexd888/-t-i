                    <a href="#">Find building instructions</a>
                    <a href="#">Replacement parts</a>
                    <a href="#">LEGO&reg; Delivery &amp; Shipping</a>
                    <a href="#">LEGO&reg; Returns</a>    
                    <a href="#">Payment methods</a>
                    <a href="#">Terms &amp; conditions</a>
                    <a href="#">Product recalls</a>
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript">
        const slide = document.querySelectorAll(".slide");
        let currentSlide = 0;
        Display(currentSlide);
        function Next() {
            currentSlide++;
            if (currentSlide >= slide.length) { currentSlide = 0; }
            Display(currentSlide);
        }
        function Prev() {
            currentSlide--;
            if (currentSlide < 0) { currentSlide = slide.length - 1; }
            Display(currentSlide);
        }
        function Display(i) {
            //xóa mọi active trước khi show
            for (let index = 0; index < slide.length; index++) {
                slide[index].classList.remove("active");
            }
            //hiện currentSlide
            slide[i].classList.add("active");
        }
    </script>
</body>
</html>
