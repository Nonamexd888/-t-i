<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <title>@ViewBag.Title</title>
  
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body, html {
            height: 100%;
            font-family: Arial,'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
        }
        /*text-danger nhưng không dùng bootstrap, tự định nghĩa  */
        .text-danger{
            color:#c71e1e;
            font-weight: bold;
        }
        /* 1. Lớp nền mờ (Overlay) */
        .modal-overlay {
            display: none; /* Mặc định ẩn */
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: rgba(0, 0, 0, 0.6); /* Màu đen mờ 60% */
            z-index: 999; /* Nằm trên mọi thứ */
        }

        /* 2. Khung chứa LEGO Insiders */
        .modal-insiders-container {
            display: none; /* Mặc định ẩn */
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%); /* Căn giữa màn hình */
            z-index: 1000; /* Nằm trên nền mờ */
            width: 1000px;
            /* Không cần thêm nền trắng ở đây vì file _Insiders đã có khung riêng */
        }

            /* 3. Khi cần hiện (Dùng JS hoặc CSS để thêm class active) */
            .modal-overlay.active,
            .modal-insiders-container.active {
                display: block;
            }

        /* Tùy chỉnh nút đóng (X) cho đẹp */
        .close {
            position: absolute;
            right: 15px;
            top: 15px;
            width: 45px;
            height: 45px;
            border: none;
            border-radius: 50%;
            background: white;
            font-size: 30px;
            cursor: pointer;
            z-index: 1001;
        }

        .Customer_container {
            display: grid;
            background-color: grey;
            grid-template-areas:
                "header"
                "content"
                "footer";
            grid-template-columns: auto;
            /* grid-auto-rows: auto auto auto 1fr auto;*/
            grid-auto-rows: auto 1fr auto;
            height: 100%;
            gap: 0;
        }

        .header {
            grid-area: header;
            display: flex;
            background-color: #FFD400;
            height: 75px;
            padding: 6px 25px;
            align-items: center;
            justify-content: space-between; /*Tạo khoản trống giữa để đẩy nội dung qua 2 bên*/
        }

        /*Left menu*/
        .header-location1 {
            display: flex;
            align-items: center;
            gap: 50px;
        }

        .back_home {
            border: none;
            cursor: pointer;
            display: inline-flex;
            background-color: transparent;
        }

        .header-toolbar {
            transition: all 0.2s ease;
            display: inline-block; /*Giúp thuộc tính khác hoạt động chuẩn*/
            text-decoration: none;
            color: black;
        }

            .header-toolbar:hover {
                color: white;
                border-radius: 50px;
                padding: 8px 10px;
                cursor: pointer;
                text-decoration: none;
                background-color: #E60101;
                transform: scale(1.3); /*Làm to 130% hơn ban đầu*/
            }

        .reset-page {
            border-radius: 5px;
            background-color: white;
            padding: 8px 20px;
            color: red;
            border-radius: 5px;
            text-decoration: none;
        }

            .reset-page:hover {
                cursor: pointer;
                background-color: black;
                color: white;
            }

        /*Right menu*/
        .header-location2 {
            display: flex;
            align-items: center;
            gap: 22px;
        }

        .search-box-lego {
            display: flex;
            align-items: center;
            background-color: white;
            border: 1px solid #d9d9d9;
            border-radius: 25px;
            padding: 6px 16px;
            width: 280px;
            height: 38px;
            box-sizing: border-box;
            transition: border-color 0.2s ease;
        }

            .search-box-lego:focus-within,
            .search-box-lego:hover {
                border: 2px solid #0045B7;
            }

            .search-box-lego i {
                font-size: 16px;
                color: #000000;
                margin-right: 10px;
            }

            .search-box-lego input {
                border: none;
                outline: none;
                background: transparent;
                width: 100%;
                font-size: 15px;
                color: #2c2c2c;
            }

        .head-icon {
            display: inline-block;
            cursor: pointer;
            font-size: 14px;
            font-weight: 550;
            border-radius: 25px;
            padding: 6px 12px;
            transition: background-color 0.2s ease;
        }

            .head-icon:hover {
                color: white;
                background-color: #E60101;
            }

            .head-icon a {
                display: flex;
                align-items: center;
                gap: 8px;
                text-decoration: none; /*Bỏ gạch chân*/
                color: inherit;
            }

            .head-icon img {
                width: 26px;
                height: 26px;
                object-fit: contain; /*Chỉnh ảnh vừa khung*/
            }

        .heart-icon {
            display: inline-block;
            align-items: center;
            cursor: pointer;
            font-size: 22px;
            color: #000000;
            border-radius: 25px;
            padding: 8px 11px;
            transition: background-color 0.2s ease;
        }

            .heart-icon:hover {
                color: white;
                background-color: #E60101;
                padding: 8px 11px;
            }

        .cart-icon {
            display: inline-block;
            cursor: pointer;
            border-radius: 25px;
            padding: 10px;
            transition: background-color 0.2s ease;
        }

            .cart-icon a {
                display: flex;
                align-items: center;
                gap: 6px;
                text-decoration: none;
                color: inherit;
            }

            .cart-icon i {
                font-size: 22px;
            }

            .cart-icon span {
                font-size: 14px;
                font-weight: 500;
            }

            .cart-icon:hover {
                color: white;
                background-color: #E60101;
            }

        .footer {
            grid-area: footer;
            position: relative;
            background-color: #141414;
            color: white;
            padding: 56px 20px 50px;
        }

            .footer::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 6px;
                background: linear-gradient(90deg, #E3000B 0%, #E3000B 25%, #FFD400 25%, #FFD400 50%, #0055BF 50%, #0055BF 75%, #00A651 75%, #00A651 100%);
            }

        .footer_inner {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 40px 80px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .footer_logo img {
            width: 120px;
            height: 120px;
            border-radius: 8px;
            transition: transform 0.3s ease;
        }

            .footer_logo img:hover {
                transform: scale(1.06) rotate(-3deg);
            }

        .footer_col {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

            .footer_col h3 {
                position: relative;
                margin: 0 0 10px 0;
                padding-bottom: 12px;
                font-size: 24px;
            }

                .footer_col h3::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: 0;
                    width: 40px;
                    height: 3px;
                    border-radius: 2px;
                    background-color: #FFD400;
                    transition: width 0.3s ease;
                }

            .footer_col:hover h3::after {
                width: 90px;
            }

            .footer_col a {
                display: inline-block;
                align-self: flex-start;
                color: white;
                text-decoration: none;
                font-size: 16px;
                transition: color 0.2s ease, transform 0.2s ease;
            }

                .footer_col a:hover {
                    color: #FFD400;
                    text-decoration: none;
                    transform: translateX(6px);
                }

        .content {
            grid-area: content;
            position: relative;
            background-color: white;
        }
    </style>
</head>
<body>
    <div class="Customer_container">
        <div class="header">
            <div class="header-location1">
                <a class="back_home" href="@Url.Action("Home_page","Home")">
                    <img src="~/Content/Content_Shopping_stalls/Img_Page1/Hình logo LEGO.svg" width="55" height="55" />
                </a>
                @Html.ActionLink("Home", "#", "#", null, new { @class = "header-toolbar" })
                @Html.ActionLink("Danh mục", "Index", "Categories", null, new { @class = "header-toolbar" })
                @Html.ActionLink("Sản phẩm", "#", "#", null, new { @class = "header-toolbar" })
                @Html.ActionLink("Khách hàng", "#", "#", null, new { @class = "header-toolbar" })
                @Html.ActionLink("Đơn hàng", "#", "#", null, new { @class = "header-toolbar" })
                @Html.ActionLink("Tài khoản", "UserProfile", "Account", null, new { @class = "header-toolbar" })
                <a class="reset-page" href="">
                    NEW
                </a>
            </div>
            <div class="header-location2">
                <div class="search-box-lego">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" placeholder="Search" @*Hiển thị văn bản mờ*@ />
                </div>
                <div class="head-icon">
                    @*<a href="http://localhost:52291/Sign/Dangnhap">
                        <img src="~/Content/Content_Shopping_stalls/Img_Page1/Hình đầu lego.svg" alt="Sign In" />
                        <span>Sign Up</span>
                    </a>*@
                    <a href="#" onclick="openInsidersPopup(); return false;" class="header-toolbar"><img src="~/Content/Content_Shopping_stalls/Img_Page1/Hình đầu lego.svg" alt="Sign In" /><span>Sign Up</span></a>
                </div>
                <div class="heart-icon">
                    <i class="fa-regular fa-heart"></i>
                </div>

                <div class="cart-icon">
                    <a href="/Home/Shopping_cart_Buy/ThanhToan">
                        <i class="fa-solid fa-bag-shopping"></i>
                        <span>(0)</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="content">@RenderBody()</div>
        @if (IsSectionDefined("footer"))
        {
            @RenderSection("footer", required: false)
        }
        else
        {
            <div class="footer">
                <div class="footer_inner">
                    <div class="footer_col footer_logo">
                        <img src="~/Content/Img_HomePage/LEGO_logo.jpg" alt="LEGO" />
                    </div>
                    <div class="footer_col">
                        <h3>ABOUT US</h3>
                        <a href="#">Nguyễn Gia Bảo</a>
                        <a href="#">Nguyễn Hồng Ngọc Nghĩa</a>
                        <a href="#">Nguyễn Hồng Ngọc Nghĩa</a>
                    </div>

                    <div class="footer_col">
                        <h3>SUPPORT</h3>
                        <a href="#">Claude</a>
                        <a href="#">DeepSeek</a>
                        <a href="#">Gemini bản free</a>
                    </div>
                </div>
            </div>
        }
    </div>
    <!-- Nền mờ bao phủ toàn màn hình -->
    <div id="modal-overlay" class="modal-overlay"></div>

    <!-- Gọi cái khung LEGO Insiders (đã bọc trong 1 thẻ div để dễ ẩn/hiện) -->
    <div id="modal-insiders" class="modal-insiders-container">
        @Html.Partial("InsiderPV")
    </div>

    <script>
        // Hàm mở popup
        function openInsidersPopup() {
            document.getElementById("modal-overlay").classList.add("active");
            document.getElementById("modal-insiders").classList.add("active");
        }

        // Hàm đóng popup
        function closeInsidersPopup() {
            document.getElementById("modal-overlay").classList.remove("active");
            document.getElementById("modal-insiders").classList.remove("active");
        }

        // Bấm ra ngoài nền mờ để đóng popup
        document.getElementById("modal-overlay").addEventListener("click", function () {
            closeInsidersPopup();
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>