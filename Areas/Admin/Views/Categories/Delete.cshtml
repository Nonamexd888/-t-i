@model Đề_tài.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

@Html.Partial("~/Areas/Admin/Views/Products/PVProductTheme.cshtml")

<div class="form-page">
    <div class="product-section theme-lego">
        <h2 class="page-title">XÓA DANH MỤC</h2>

        <div class="form-card">
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.ErrorMessage
                </div>
            }

            <p class="delete-warning">Bạn có chắc sẽ xóa danh mục này?</p>

            @Html.Partial("PVDeleteDetailsCategory", Model)

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-actions-lego">
                    <input type="submit" value="XÓA" class="btn btn-delete" />
                    @Html.ActionLink("QUAY VỀ DANH MỤC", "Index", null, new { @class = "btn btn-back" })
                </div>
            }
        </div>
    </div>
</div>
