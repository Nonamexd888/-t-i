@model Đề_tài.Models.Order
@{
    ViewBag.Title = "Chi tiết Đơn hàng #" + Model.OrderID;
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<div class="container-fluid" style="margin-top: 20px; margin-bottom: 50px;">
    <h2 style="font-weight: bold; color: #E3000B; text-transform: uppercase; border-bottom: 3px solid #FFD400; padding-bottom: 10px; display: inline-block;">
        Chi tiết Đơn Hàng #@Model.OrderID
    </h2>

    <div class="mb-3 mt-3">
        <a href="@Url.Action("Index")" class="btn btn-default" style="border: 1px solid #ccc; background-color: white;">
            <i class="fa-solid fa-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="row">
        <!-- Thông tin khách hàng -->
        <div class="col-md-6 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light font-weight-bold">
                    <i class="fa-solid fa-user text-primary"></i> Thông tin Khách hàng
                </div>
                <div class="card-body">
                    <p><strong>Họ tên:</strong> @(Model.Customer != null ? Model.Customer.CustomerName : "N/A")</p>
                    <p><strong>Số điện thoại:</strong> @(Model.Customer != null ? Model.Customer.CustomerPhone : "N/A")</p>
                    <p><strong>Địa chỉ giao hàng:</strong> @Model.AddressDelivery</p>
                </div>
            </div>
        </div>

        <!-- Thông tin đơn hàng -->
        <div class="col-md-6 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light font-weight-bold">
                    <i class="fa-solid fa-file-invoice text-success"></i> Thông tin Đơn hàng
                </div>
                <div class="card-body">
                    <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <p><strong>Hình thức thanh toán:</strong> @Model.PaymentMethod (@Model.PaymentStatus)</p>
                    <p><strong>Hình thức giao hàng:</strong> @Model.DeliveryMethod</p>
                    <p class="mb-0"><strong>Tổng tiền:</strong> <span style="color: #E3000B; font-weight: bold; font-size: 20px;">@String.Format("{0:N0} USD", Model.TotalAmount)</span></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách sản phẩm (VIẾT TRỰC TIẾP TẠI ĐÂY) -->
    <div class="card shadow-sm border-0 mt-4">
        <div class="card-header" style="background-color: #141414; color: white;">
            <h5 class="mb-0" style="font-weight: bold;"><i class="fa-solid fa-box-open"></i> Danh sách sản phẩm</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-bordered mb-0">
                <thead style="background-color: #f1f1f1;">
                    <tr>
                        <th>Tên Sản Phẩm</th>
                        <th style="text-align: center; width: 15%;">Số Lượng</th>
                        <th style="text-align: right; width: 20%;">Đơn Giá</th>
                        <th style="text-align: right; width: 20%;">Thành Tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                    {
                        foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td style="vertical-align: middle;">
                                    @(item.Product != null ? item.Product.ProductName : "Sản phẩm không tồn tại")
                                </td>
                                <td style="text-align: center; vertical-align: middle;">@item.Quantity</td>
                                <td style="text-align: right; vertical-align: middle;">@String.Format("{0:N0} USD", item.UnitPrice)</td>
                                <td style="text-align: right; vertical-align: middle; font-weight: bold;">
                                    @String.Format("{0:N0} USD", item.TotalPrice)
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" style="text-align: center; color: gray; padding: 20px;">Không có sản phẩm nào trong đơn hàng này.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>