                    <button class="AddToCart">Add to bag</button>
                </div>
                <div class="product">
                    <img class="product_img" src="https://www.lego.com/cdn/cs/set/assets/blte6308ce7b5b80dba/67012_Prod.png?format=webply&fit=bounds&quality=90&width=250&height=250&dpr=1.5" />

                    <p class="name">The Joker<sup>TM</sup> Wall Art Comic Cover</p>
                    <p class="price">$169.99</p>


                    <button class="AddToCart">Add to bag</button>
                </div>
            </div>

            <div class="slide">
                <div class="product">
                    <img class="product_img" src="https://www.lego.com/cdn/cs/set/assets/blt59f10fadf173c1ba/blt3435be8c14df0276-72154_Prod_en-gb.png?format=webply&fit=bounds&quality=90&width=250&height=250&dpr=1.5" />

                    <p class="name">Iconic Trainer Moments Poke Ball</p>
                    <p class="price">$299.99</p>


                    <button class="AddToCart">Add to bag</button>
                </div>
                <div class="product">
                    <img class="product_img" src="https://www.lego.com/cdn/cs/set/assets/blt96a11f71928f8103/72046_Prod_en-gb.png?format=webply&fit=bounds&quality=90&width=250&height=250&dpr=1.5" />

                    <p class="name">GAME BOY</p>
                    <p class="price">$59.99</p>


                    <button class="AddToCart">Add to bag</button>
                </div>
                <div class="product">
                    <img class="product_img" src="https://www.lego.com/cdn/cs/set/assets/blt621a9fb4f7d5deba/bltc8cac287dd2bee85-11512_Prod_en-gb.png?format=webply&fit=bounds&quality=90&width=250&height=250&dpr=1.5" />

                    <p class="name">Hanging Golden Pothos</p>
                    <p class="price">$59.99</p>


                    <button class="AddToCart">Add to bag</button>
                </div>
                <div class="product">
                    <img class="product_img" src="https://www.lego.com/cdn/cs/set/assets/bltad314f25ee503191/21373_Prod.png?format=webply&fit=bounds&quality=90&width=250&height=250&dpr=1.5" />

                    <p class="name">Downton Abbey</p>
                    <p class="price">$349.99</p>


                    <button class="AddToCart">Add to bag</button>
