@model Đề_tài.Models.ViewModel.Order.CheckoutVM
@{
    ViewBag.Title = "Đặt hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    /* --- 1. NỀN VÀ TRANG TRÍ LEGO --- */
    .checkout-page {
        background: linear-gradient(135deg, #fff9c4 0%, #ffd54f 100%);
        padding: 40px 15px;
        font-family: 'Montserrat', sans-serif;
        min-height: 100vh;
    }

    .checkout-container {
        max-width: 1000px;
        margin: 0 auto;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(15px);
        border: 2px solid #fff;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    }

    h2 {
        text-align: center;
        font-weight: 800;
        color: #E60101;
        margin-bottom: 30px;
        text-transform: uppercase;
    }

    h3 {
        font-size: 18px;
        font-weight: 700;
        color: #333;
        border-left: 5px solid #E60101;
        padding-left: 10px;
        margin: 25px 0 15px;
    }

    /* --- 2. BẢNG SẢN PHẨM --- */
    .table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
    }

        .table th {
            background-color: #f8f9fa;
            font-weight: 700;
            padding: 12px;
            border-bottom: 2px solid #eee;
            text-align: left;
        }

        .table td {
            padding: 12px;
            vertical-align: middle;
            border-bottom: 1px solid #eee;
        }

        .table img {
            max-height: 60px;
            border-radius: 5px;
        }

    /* --- 3. FORM NHẬP LIỆU --- */
    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            font-weight: 600;
            color: #444;
            margin-bottom: 8px;
            display: block;
        }

    .form-control {
        border-radius: 10px;
        border: 2px solid #ddd;
        padding: 10px;
        transition: all 0.3s;
        width: 100%;
    }

        .form-control:focus {
            border-color: #E60101;
            box-shadow: 0 0 0 3px rgba(230,1,1,0.1);
        }

    /* --- 4. RADIO BUTTON --- */
    .radio-group {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .radio-item {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .radio-item input[type="radio"] {
            width: 18px;
            height: 18px;
            accent-color: #E60101;
            cursor: pointer;
        }

    /* --- 5. NÚT BẤM 3D LEGO --- */
    .btn-primary {
        background-color: #E60101;
        border: none;
        border-radius: 10px;
        padding: 12px 30px;
        font-weight: 700;
        text-transform: uppercase;
        box-shadow: 0 6px 0 #8a0000;
        transition: all 0.1s;
        color: white;
        cursor: pointer;
    }

        .btn-primary:hover {
            background-color: #ff1a1a;
            transform: translateY(-2px);
            box-shadow: 0 8px 0 #8a0000;
            color: white;
        }

        .btn-primary:active {
            transform: translateY(6px);
            box-shadow: 0 0 0 #8a0000;
        }

    /* --- 6. THÔNG BÁO LỖI --- */
    .text-danger {
        color: #dc3545 !important;
        font-weight: 600;
        font-size: 14px;
        display: block;
        margin-top: 5px;
    }

    .validation-summary-errors {
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        color: #721c24;
        font-weight: 600;
    }
</style>
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}
<div class="checkout-page">
    <div class="checkout-container">
        <h2>ĐẶT HÀNG</h2>

        @using (Html.BeginForm("Checkout", "Order", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

            <h3>Thông tin đơn hàng</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th colspan="2">Sản phẩm</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CartItems)
                    {
                        <tr>
                            <td><img src="@Url.Content(item.ProductImage)" alt="@item.ProductName" /></td>
                            <td>@item.ProductName</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice.ToString("N0")</td>
                            <td>@item.TotalPrice.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <h3>Thông tin giao hàng</h3>

            <!-- ĐỊA CHỈ GIAO HÀNG -->
            <div class="form-group">
                @Html.LabelFor(m => m.ShippingAddress, new { @class = "control-label" })
                @Html.TextBoxFor(m => m.ShippingAddress, new { @class = "form-control", @readonly = "readonly", @id = "shippingAddress" })
                <button type="button" class="btn btn-link" style="color: #E60101; font-weight: 600; padding: 0; margin-top: 5px;" onclick="enableAddressEdit()">Chỉnh sửa địa chỉ</button>
                @Html.ValidationMessageFor(m => m.ShippingAddress, "", new { @class = "text-danger" })
            </div>

            <div class="form-group" id="newAddressGroup" style="display:none;">
                <label>Địa chỉ mới</label>
                <input type="text" id="newShippingAddress" class="form-control" />
            </div>

            <!-- PHƯƠNG THỨC GIAO HÀNG -->
            <div class="form-group">
                @Html.Label("Phương thức giao hàng", new { @class = "control-label" })
                <div class="radio-group">
                    <div class="radio-item">
                        @Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng nhanh", new { id = "shippingFast" })
                        <label for="shippingFast">Giao hàng nhanh</label>
                    </div>
                    <div class="radio-item">
                        @Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng tiết kiệm", new { id = "shippingSave" })
                        <label for="shippingSave">Giao hàng tiết kiệm</label>
                    </div>
                </div>
                @Html.ValidationMessageFor(m => m.ShippingMethod, "", new { @class = "text-danger" })
            </div>

            <!-- PHƯƠNG THỨC THANH TOÁN -->
            <div class="form-group">
                @Html.Label("Phương thức thanh toán", new { @class = "control-label" })
                <div class="radio-group">
                    <div class="radio-item">
                        @Html.RadioButtonFor(m => m.PaymentMethod, "Tiền mặt", new { id = "paymentCash" })
                        <label for="paymentCash">Tiền mặt</label>
                    </div>
                    <div class="radio-item">
                        @Html.RadioButtonFor(m => m.PaymentMethod, "Mua trước trả sau", new { id = "paymentDebt" })
                        <label for="paymentDebt">Mua trước trả sau</label>
                    </div>
                </div>
                @Html.ValidationMessageFor(m => m.PaymentMethod, "", new { @class = "text-danger" })
            </div>

            <!-- TỔNG TIỀN -->
            <div class="form-group">
                @Html.LabelFor(m => m.TotalAmount, new { @class = "control-label" })
                @Html.TextBoxFor(m => m.TotalAmount, new { @class = "form-control", @readonly = "readonly" })
            </div>

            <!-- NÚT ĐẶT HÀNG -->
            <div class="form-group text-center" style="margin-top: 30px;">
                <input type="submit" value="Đặt hàng" class="btn btn-primary" onclick="updateShippingAddress()" />
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        function enableAddressEdit() {
            document.getElementById("shippingAddress").removeAttribute("readonly");
            document.getElementById("newAddressGroup").style.display = "block";
        }

        function updateShippingAddress() {
            var newAddress = document.getElementById("newShippingAddress").value;
            if (newAddress) {
                document.getElementById("shippingAddress").value = newAddress;
            }
        }
    </script>
}