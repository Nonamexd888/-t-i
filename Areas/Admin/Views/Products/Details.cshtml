@model Đề_tài.Models.Product

@{
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

@Html.Partial("PVProductTheme")

<div class="form-page">
    <div class="product-section theme-lego">
        <h2 class="page-title">CHI TIẾT SẢN PHẨM</h2>

        <div class="form-card">
            @Html.Partial("PVDeleteDetailsProduct", Model)

            <div class="form-actions-lego">
                @Html.ActionLink("SỬA", "Edit", new { id = Model.ProductID }, new { @class = "btn btn-primary" })
                @Html.ActionLink("QUAY VỀ MỤC SẢN PHẨM", "Index", null, new { @class = "btn btn-back" })
            </div>
        </div>
    </div>
</div>