@model Đề_tài.Models.Category

@{
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<h2>CHI TIẾT DANH MỤC</h2>

<div>
    <h4>Category</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            Tên danh mục
        </dt>

        <dd>
            @Html.DisplayFor(model => model.CategoryName)
        </dd>

        <dt>
            Ảnh danh mục
        </dt>

        <dd>
            @if (!string.IsNullOrEmpty(Model.CategoryImage))
            {<img src="@Url.Content(Model.CategoryImage)" />} @*nếu để bình thường html.DisplayFor thì trình duyệt ko hiểu ~*@
            else
            {
                @:Không có ảnh
            }
        </dd>

    </dl>
</div>
<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.CategoryID }, new { @class = "btn btn-primary" }) |
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-primary" })
</p>
