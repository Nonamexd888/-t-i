@model Đề_tài.Models.ViewModel.Cart.Cart
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using PagedList.Mvc;
@using PagedList;

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    /* --- 1. NỀN VÀ TRANG TRÍ LEGO --- */
    .shoppingcart {
        background: linear-gradient(135deg, #fff9c4 0%, #ffd54f 100%);
        padding: 40px 15px;
        font-family: 'Montserrat', sans-serif;
        min-height: 80vh;
        position: relative;
        overflow: hidden;
    }

        .shoppingcart::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: radial-gradient(#E6A800 1px, transparent 1px);
            background-size: 20px 20px;
            opacity: 0.1;
            z-index: 0;
        }

    /* --- 2. KHUNG CHÍNH (KÍNH MỜ) --- */
    .cart-wrapper {
        position: relative;
        z-index: 1;
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        gap: 25px;
        align-items: flex-start;
    }

    .cart-main {
        flex: 1;
        min-width: 60%;
    }

    .cart-sidebar {
        width: 350px;
        flex-shrink: 0;
    }

    /* --- 3. THẺ SẢN PHẨM (CARD) --- */
    .cart-section {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(15px);
        border: 2px solid #fff;
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

        .cart-section h2 {
            font-size: 24px;
            font-weight: 800;
            color: #222;
            margin-bottom: 20px;
            border-left: 5px solid #E60101;
            padding-left: 15px;
        }

    /* Bảng sản phẩm */
    .table {
        width: 100%;
        border-collapse: collapse;
    }

        .table th {
            background-color: #f8f9fa;
            color: #333;
            font-weight: 700;
            padding: 15px;
            border-bottom: 2px solid #eee;
            text-align: left;
        }

        .table td {
            padding: 15px;
            vertical-align: middle;
            border-bottom: 1px solid #eee;
            color: #444;
        }

        .table tr:hover {
            background-color: #fcfcfc;
        }

    /* Nút tăng giảm số lượng */
    .quantity-control {
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .quantity-control button {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: 1px solid #ddd;
            background: #fff;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .quantity-control button:hover {
                background: #E60101;
                color: white;
                border-color: #E60101;
            }

        .quantity-control input {
            width: 50px;
            text-align: center;
            border: 1px solid #ddd;
            border-radius: 5px;
            padding: 5px;
            font-weight: bold;
        }

    /* Nút xóa */
    .btn-remove {
        color: #E60101;
        font-size: 18px;
        transition: transform 0.2s;
    }

        .btn-remove:hover {
            transform: scale(1.2);
        }

    /* --- 4. SIDEBAR THANH TOÁN --- */
    .checkout-box {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(15px);
        border: 2px solid #FFD400;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        position: sticky;
        top: 20px;
    }

        .checkout-box h3 {
            font-size: 20px;
            font-weight: 800;
            color: #222;
            margin-bottom: 20px;
            text-align: center;
            text-transform: uppercase;
        }

    .total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 18px;
        margin-bottom: 25px;
        padding-top: 15px;
        border-top: 1px dashed #ccc;
    }

        .total-row span:first-child {
            font-weight: 600;
            color: #555;
        }

        .total-row span:last-child {
            font-size: 24px;
            font-weight: 800;
            color: #E60101;
        }

    /* Nút bấm 3D LEGO */
    .cart-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 15px;
        background-color: #E60101;
        color: white !important;
        font-size: 16px;
        font-weight: 800;
        text-transform: uppercase;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.1s ease;
        box-shadow: 0 6px 0 #8a0000, 0 10px 15px rgba(0,0,0,0.2);
        text-decoration: none;
        margin-bottom: 15px;
    }

        .cart-button:hover {
            background-color: #ff1a1a;
            transform: translateY(-2px);
            box-shadow: 0 8px 0 #8a0000, 0 15px 20px rgba(0,0,0,0.3);
            color: white !important;
            text-decoration: none;
        }

        .cart-button:active {
            transform: translateY(6px);
            box-shadow: 0 0px 0 #8a0000, 0 2px 5px rgba(0,0,0,0.3);
        }

    .btn-continue {
        background-color: #fff;
        color: #333 !important;
        box-shadow: 0 4px 0 #ddd;
        border: 2px solid #ddd;
    }

        .btn-continue:hover {
            background-color: #f9f9f9;
            color: #E60101 !important;
            border-color: #E60101;
            box-shadow: 0 6px 0 #ccc;
        }

        .btn-continue:active {
            transform: translateY(4px);
            box-shadow: 0 0px 0 #ddd;
        }

    /* Empty cart */
    .empty-cart {
        text-align: center;
        padding: 50px;
        background: rgba(255, 255, 255, 0.9);
        border-radius: 16px;
        font-size: 18px;
        color: #555;
    }

    /* --- 5. PHẦN SẢN PHẨM TƯƠNG TỰ (GỘP VÀO ĐÂY) --- */
    .similar-section {
        margin-top: 30px;
        padding: 20px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(15px);
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        border: 2px solid #fff;
    }

        .similar-section h2 {
            font-size: 22px;
            font-weight: 800;
            color: #E60101;
            margin-bottom: 20px;
            text-transform: uppercase;
            border-left: 5px solid #E60101;
            padding-left: 15px;
        }

    .list-container {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .lproduct-item {
        width: calc(20% - 12px);
        background: #fff;
        border-radius: 12px;
        padding: 10px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        transition: all 0.3s ease;
        border: 1px solid #eee;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        text-align: center;
    }

        .lproduct-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
            border-color: #FFD400;
        }

        .lproduct-item img {
            width: 100%;
            height: 160px;
            object-fit: contain;
            margin-bottom: 10px;
        }

    .prodName {
        font-size: 13px;
        font-weight: 700;
        color: #333;
        margin-bottom: 5px;
        line-height: 1.4;
        min-height: 50px;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
    }

    .prodPrice {
        font-size: 15px;
        font-weight: 800;
        color: #E60101;
        margin-bottom: 10px;
    }

    .btn.btn-info {
        background-color: #E60101 !important;
        border: none !important;
        color: white !important;
        font-weight: 700;
        border-radius: 8px;
        padding: 8px 10px;
        font-size: 13px;
        transition: all 0.2s ease;
        text-decoration: none;
        display: block;
        width: 100%;
    }

        .btn.btn-info:hover {
            background-color: #ff1a1a !important;
            box-shadow: 0 4px 10px rgba(230, 1, 1, 0.3);
        }

    .pagination-container {
        margin-top: 20px;
        text-align: center;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .cart-sidebar {
            width: 100%;
        }

        .lproduct-item {
            width: calc(25% - 12px);
        }
    }

    @@media (max-width: 768px) {
        .lproduct-item {
            width: calc(33.33% - 10px);
        }
    }

    @@media (max-width: 480px) {
        .lproduct-item {
            width: calc(50% - 8px);
        }
    }
</style>

<div class="shoppingcart">
    <div class="cart-wrapper">
        <!-- CỘT TRÁI: DANH SÁCH SẢN PHẨM -->
        <div class="cart-main">
            <div class="cart-section">
                <h2>GIỎ HÀNG CỦA BẠN</h2>
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger" style="background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; border-radius: 8px; padding: 15px; margin-bottom: 20px; font-weight: 600;">
                        <i class="fa-solid fa-triangle-exclamation"></i> @TempData["ErrorMessage"]
                    </div>
                }
                @if (!Model.Items.Any())
                {
                    <div class="empty-cart">
                        <i class="fa-solid fa-cart-shopping" style="font-size: 50px; color: #ddd; margin-bottom: 20px;"></i>
                        <p>Bạn chưa có sản phẩm nào trong giỏ hàng.</p>
                    </div>
                }
                else
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th colspan="2">Sản phẩm</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th>Thành tiền</th>
                                <th title="Xóa tất cả mặt hàng trong giỏ">
                                    <a href="@Url.Action("ClearCart", "Cart", null)" class="btn-remove">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td style="width: 100px;">
                                        <img src="@Url.Content(item.ProductImage)" alt="@item.ProductName" style="max-height: 80px; border-radius: 8px;" />
                                    </td>
                                    <td style="font-weight: 600;">@item.ProductName</td>
                                    <td>
                                        @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post))
                                        {
                                            <input type="hidden" name="id" value="@item.ProductID" />
                                            <div class="quantity-control">
                                                <button type="button" onclick="cartUpdateQuantity(@item.ProductID, @item.Quantity - 1, @item.ProductStock)">-</button>
                                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.ProductStock" readonly />
                                                <button type="button" onclick="cartUpdateQuantity(@item.ProductID, @item.Quantity + 1, @item.ProductStock)">+</button>
                                            </div>
                                        }
                                    </td>
                                    <td>@item.UnitPrice.ToString("N2") USD</td>
                                    <td style="font-weight: 700; color: #E60101;">@item.TotalPrice.ToString("N2") USD</td>
                                    <td>
                                        <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.ProductID })" class="btn-remove">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <!-- CỘT PHẢI: THANH TOÁN -->
        <div class="cart-sidebar">
            <div class="checkout-box">
                <h3>Tổng đơn hàng</h3>
                <div class="total-row">
                    <span>Tổng giá trị:</span>
                    <span>@Model.TotalValue().ToString("N2") USD</span>
                </div>

                @Html.ActionLink("Mua hàng", "Checkout", "Order", null, new { @class = "cart-button" })
                @Html.ActionLink("Tiếp tục mua hàng", "Home_page", "Home", null, new { @class = "cart-button btn-continue" })
            </div>
        </div>
    </div>

    <!-- PHẦN SẢN PHẨM TƯƠNG TỰ (ĐÃ GỘP VÀO ĐÂY) -->
    @if (Model.SimilarProducts != null && Model.SimilarProducts.Any())
    {
        <div class="similar-section">
            <h2>Sản phẩm tương tự</h2>
            <ul class="list-container">
                @foreach (var product in Model.SimilarProducts)
                {
                    <li class="lproduct-item">
                        <div>
                            <a href="@Url.Action("AddToCart", "Cart", new { id = product.ProductID })">
                                <img src="@Url.Content(product.ProductImage)" />
                            </a>
                        </div>
                        <div class="prodName">@product.ProductName </div>
                        <div class="prodPrice">@product.ProductPrice.ToString("N2") &nbsp; USD</div>
                        <div>
                            @Html.ActionLink("Thêm vào giỏ hàng", "AddToCart", "Cart",
                                new { id = product.ProductID },
                                new { @class = "btn btn-info" })
                        </div>
                    </li>
                }
            </ul>

            <!-- Hiển thị phân trang -->
            <div class="pagination-container">
                @Html.PagedListPager(Model.SimilarProducts, page => Url.Action("Index", new { page }))
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
function cartUpdateQuantity(id, newQuantity, productStock) {
    if (newQuantity < 1) return;
    if (newQuantity > 10) return; // Chặn vượt 10
            if (newQuantity > productStock) return; // Chặn vượt tồn kho
            const form = document.createElement('form');
            form.method = 'post';
            form.action = '@Url.Action("UpdateQuantity", "Cart")';

            const idInput = document.createElement('input');
            idInput.type = 'hidden';
            idInput.name = 'id';
            idInput.value = id;
            form.appendChild(idInput);

            const quantityInput = document.createElement('input');
            quantityInput.type = 'hidden';
            quantityInput.name = 'quantity';
            quantityInput.value = newQuantity;
            form.appendChild(quantityInput);

            document.body.appendChild(form);
            form.submit();
        }
    </script>
}