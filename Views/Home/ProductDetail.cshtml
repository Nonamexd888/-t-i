@model Đề_tài.Models.ViewModel.Home.ProductDetailVM

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&display=swap" rel="stylesheet">

<style>
    .maximumAmount {
        
        color:grey;
        
    }
    /* --- 1. NỀN LEGO LỘNG LẪY --- */
    .product-container {
        position: relative;
        padding: 40px 15px;
        background: linear-gradient(135deg, #fff9c4 0%, #ffd54f 100%); /* Nền vàng LEGO */
        overflow: hidden;
        font-family: 'Montserrat', sans-serif;
        min-height: 100vh;
    }

    /* Các khối gạch LEGO 3D trang trí nền */
    .lego-brick-bg {
        position: absolute;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        box-shadow: inset -4px -4px 0 rgba(0,0,0,0.05), inset 4px 4px 0 rgba(255,255,255,0.4);
        z-index: 0;
        animation: float 8s ease-in-out infinite;
    }

    .brick-1 {
        width: 150px;
        height: 80px;
        top: 5%;
        left: -20px;
        transform: rotate(15deg);
    }

    .brick-2 {
        width: 120px;
        height: 120px;
        bottom: 10%;
        right: -30px;
        transform: rotate(-20deg);
        background: rgba(230, 1, 1, 0.1);
    }

    .brick-3 {
        width: 200px;
        height: 60px;
        top: 40%;
        right: 5%;
        transform: rotate(5deg);
        background: rgba(120, 180, 105, 0.15);
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0) rotate(15deg);
        }

        50% {
            transform: translateY(-20px) rotate(20deg);
        }
    }

    /* Khung nội dung chính (Kính mờ) */
    .main-content-wrapper {
        position: relative;
        z-index: 1;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* --- BỐ CỤC 3 CỘT BẰNG FLEXBOX --- */
    .product-layout {
        display: flex;
        gap: 25px;
        align-items: flex-start;
    }

    /* --- 2. THẺ SẢN PHẨM CHUNG (Hiệu ứng kính mờ) --- */
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(15px);
        border: 2px solid #fff;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
    }

    /* --- CỘT TRÁI: ẢNH --- */
    .product-image-wrapper {
        width: 280px;
        flex-shrink: 0;
        padding: 20px;
        text-align: center;
    }

        .product-image-wrapper:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }

        .product-image-wrapper img {
            width: 100%;
            max-height: 350px;
            object-fit: contain;
            transition: transform 0.4s ease;
        }

        .product-image-wrapper:hover img {
            transform: scale(1.08);
        }

    /* --- CỘT GIỮA: THÔNG TIN --- */
    .product-info-wrapper {
        flex: 1;
        padding: 30px;
    }

    .product-title {
        font-size: 28px;
        font-weight: 800;
        color: #222;
        margin-bottom: 12px;
        line-height: 1.4;
    }

    .product-rating {
        color: #ffc107;
        font-size: 16px;
        margin-bottom: 15px;
    }

    .product-meta {
        font-size: 14px;
        color: #555;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 1px dashed #ccc;
    }

        .product-meta span {
            display: inline-block;
            margin-right: 25px;
        }

        .product-meta strong {
            color: #E60101;
            font-weight: 800;
        }

    .product-description-title {
        font-size: 18px;
        font-weight: 800;
        color: #333;
        margin-bottom: 15px;
        border-left: 5px solid #E60101; /* Đường kẻ đỏ */
        padding-left: 12px;
    }

    .product-description {
        font-size: 15px;
        line-height: 1.7;
        color: #444;
        text-align: justify;
    }

    /* --- CỘT PHẢI: MUA HÀNG --- */
    .purchase-box {
        width: 320px;
        flex-shrink: 0;
        padding: 25px;
        position: sticky;
        top: 20px;
        border: 2px solid #FFD400; /* Viền vàng LEGO */
    }

        .purchase-box h4 {
            font-size: 16px;
            font-weight: 800;
            color: #333;
            margin-bottom: 12px;
            text-transform: uppercase;
        }

    .quantity-input {
        width: 100%;
        padding: 12px;
        border: 2px solid #ddd;
        border-radius: 10px;
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 20px;
        text-align: center;
        outline: none;
        transition: border 0.3s;
    }

        .quantity-input:focus {
            border-color: #E60101;
            box-shadow: 0 0 0 3px rgba(230, 1, 1, 0.1);
        }

    .total-price {
        font-size: 24px;
        font-weight: 800;
        color: #E60101;
        margin-bottom: 20px;
        text-align: center;
        font-family: 'Montserrat', sans-serif;
    }

    /* Nút thêm vào giỏ hàng 3D LEGO */
    .btn-add-to-cart {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 16px;
        background-color: #E60101;
        color: white;
        font-size: 16px;
        font-weight: 800;
        text-transform: uppercase;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.1s ease;
        box-shadow: 0 6px 0 #8a0000, 0 10px 15px rgba(0,0,0,0.2);
        text-decoration: none;
    }

        .btn-add-to-cart:hover {
            background-color: #ff1a1a;
            transform: translateY(-2px);
            box-shadow: 0 8px 0 #8a0000, 0 15px 20px rgba(0,0,0,0.3);
            color: white;
            text-decoration: none;
        }

        .btn-add-to-cart:active {
            transform: translateY(6px);
            box-shadow: 0 0px 0 #8a0000, 0 2px 5px rgba(0,0,0,0.3);
        }

    /* --- 5. PHẦN SẢN PHẨM GỢI Ý --- */
    .section-title {
        font-size: 24px;
        font-weight: 800;
        color: #222;
        margin: 50px 0 20px 0;
        display: flex;
        align-items: center;
        gap: 10px;
        text-transform: uppercase;
        text-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }

        .section-title::before {
            content: "";
            display: inline-block;
            width: 10px;
            height: 28px;
            background-color: #E60101; /* Điểm nhấn đỏ */
            border-radius: 4px;
        }

    .product-grid {
        display: flex;
        /*flex-wrap: wrap;*/
        overflow-x:auto;
        scroll-snap-type: x mandatory;
        gap: 20px;
    }

    .product-card {
        width: calc(25% - 15px);
        background: #fff;
        border-radius: 12px;
        padding: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border: 1px solid #eee;
        scroll-snap-align: start;
        flex: 0 0 auto;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.15);
            border-color: #FFD400;
        }

        .product-card img {
            width: 100%;
            height: 180px;
            object-fit: contain;
            margin-bottom: 15px;
        }

        .product-card .name {
            font-size: 15px;
            font-weight: 700;
            color: #333;
            margin-bottom: 8px;
            min-height: 40px;
            line-height: 1.4;
        }

        .product-card .price {
            font-size: 17px;
            font-weight: 800;
            color: #E60101;
        }

    /* --- RESPONSIVE --- */
    @@media (max-width: 992px) {
        .product-layout {
            flex-wrap: wrap;
        }

        .product-image-wrapper {
            width: calc(50% - 12.5px);
        }

        .product-info-wrapper {
            width: calc(50% - 12.5px);
            flex: none;
        }

        .purchase-box {
            width: 100%;
            position: static;
            margin-top: 20px;
        }

        .product-card {
            width: calc(33.33% - 14px);
        }
    }

    @@media (max-width: 768px) {
        .product-layout {
            flex-direction: column;
        }

        .product-image-wrapper, .product-info-wrapper, .purchase-box {
            width: 100%;
        }

        .product-card {
            width: calc(50% - 10px);
        }
    }

    @@media (max-width: 480px) {
        .product-card {
            width: 100%;
        }
    }
</style>

<div class="product-container">
    <!-- Các khối gạch trang trí nền -->
    <div class="lego-brick-bg brick-1"></div>
    <div class="lego-brick-bg brick-2"></div>
    <div class="lego-brick-bg brick-3"></div>

    <div class="main-content-wrapper">
        <!-- BỐ CỤC 3 CỘT -->
        <div class="product-layout">
            <!-- CỘT TRÁI: ẢNH -->
            <div class="product-image-wrapper glass-card">
                @if (string.IsNullOrEmpty(Model.Product.ProductImage))
                {
                    <p>Chưa có ảnh</p>
                }
                else
                {
                    <img src="@Url.Content(Model.Product.ProductImage)" alt="@Model.Product.ProductName" />
                }
            </div>

            <!-- CỘT GIỮA: THÔNG TIN -->
            <div class="product-info-wrapper glass-card">
                <h1 class="product-title">@Html.DisplayFor(m => m.Product.ProductName)</h1>

                @*<div class="product-rating">
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-regular fa-star"></i>
                        <span style="color: #666; font-size: 13px; margin-left: 5px;">(Chưa có đánh giá)</span>
                    </div>*@

                <div class="product-meta">
                    <span>Đã bán: <strong>@Model.Product.OrderDetails.Sum(od => od.Quantity)</strong></span>
                    <span>Nhóm đồ chơi: <strong>@Model.Product.Category.CategoryName</strong></span>
                    <span>Số lượng còn lại:<strong>@Model.Product.ProductStock</strong></span>
                </div>

                <h4 class="product-description-title">Mô tả sản phẩm</h4>
                <div class="product-description">
                    @if (!string.IsNullOrEmpty(Model.Product.ProductDescription))
                    {
                        @Html.DisplayFor(m => m.Product.ProductDescription)
                    }
                    else
                    {
                        <p>Chưa có mô tả cho sản phẩm này.</p>
                    }
                </div>
            </div>

            <!-- CỘT PHẢI: MUA HÀNG -->
            <div class="purchase-box glass-card">
                <h4>Số lượng </h4>
                <h5><span class="maximumAmount">Tối đa 10</span></h5>
                @using (Html.BeginForm("AddToCart", "Cart", FormMethod.Post))
                {
                    <input type="hidden" name="id" value="@Model.Product.ProductID" />
                    
                    if (Model.Product.ProductStock > 0)
                    {
                        @Html.TextBoxFor(model => model.Quantity, new { @class = "quantity-input", @id = "quantityInput", @type = "number", @min = 1, @max = Model.Product.ProductStock })
                        @Html.ValidationMessageFor(model => model.Quantity)
                    }

                    else {<p style="color: red; font-weight: bold;">Sản phẩm đã hết hàng!<span><img src="https://minifigs.me/cdn/shop/files/crying-emoji-head.png?v=1713186739" style="width:50px;height:50px;" /></span></p> }

                    <div class="total-price" id="totalPrice">
                        @String.Format("{0:N2} USD", Model.EstimatedValue)
                    </div>

                    <i class="fa-solid fa-cart-plus"></i>
                    @*Html.ActionLink("Thêm vào giỏ hàng", "AddToCart", "Cart",
            new { id = Model.Product.ProductID, quantity = Model.Quantity },
            new { @class = "btn-add-to-cart" })*@
                    <button type="submit" class="btn-add-to-cart">Thêm vào giỏ hàng</button>
                }
            </div>
        </div>

        <!-- SẢN PHẨM TƯƠNG TỰ -->
        @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
        {
            <h3 class="section-title">Sản phẩm tương tự</h3>
            <div class="product-grid">
                @foreach (var product in Model.RelatedProducts)
                {
                    <div class="product-card">
                        <a href="@Url.Action("ProductDetail", "Home", new { id = product.ProductID })">
                            <img src="@Url.Content(product.ProductImage)" alt="@product.ProductName" />
                        </a>
                        <p class="name">@Html.DisplayFor(m => product.ProductName)</p>
                        <p class="price">@String.Format("{0:N2} USD", product.ProductPrice)</p>
                    </div>
                }
            </div>
        }

        <!-- SẢN PHẨM BÁN CHẠY -->
        @if (Model.TopProducts != null && Model.TopProducts.Any())
        {
            <h3 class="section-title">Sản phẩm bán chạy</h3>
            <div class="product-grid">
                @foreach (var product in Model.TopProducts)
                {
                    <div class="product-card">
                        <a href="@Url.Action("ProductDetail", "Home", new { id = product.ProductID })">
                            <img src="@Url.Content(product.ProductImage)" alt="@product.ProductName" />
                        </a>
                        <p class="name">@Html.DisplayFor(m => product.ProductName)</p>
                        <p class="price">@String.Format("{0:N2} USD", product.ProductPrice)</p>
                    </div>
                }
            </div>

        }
    </div>
</div>

@section scripts{
    <script>
        var input = document.getElementById("quantityInput");
        var maxStock = @Model.Product.ProductStock;
        var price = @Model.Product.ProductPrice;
        input.addEventListener("input", function () {
            if (input.value < 1) input.value = 1;
            if (input.value > 10) input.value = 10;
            if (input.value > maxStock) {
                input.value = maxStock; alert("Chỉ còn " + maxStock + " sản phẩm trong kho!");
 }
            
            var text = document.getElementById("totalPrice");
            money = input.value * price;
            text.innerHTML =money.toFixed(2) + " USD";
        })
    </script>
}