@model Đề_tài.Models.ViewModel.Admin.OrderSearch
@using PagedList.Mvc;
@{
    ViewBag.Title = "Quản lý Đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<div class="container-fluid" style="margin-top: 20px; margin-bottom: 50px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="font-weight: bold; color: #E3000B; text-transform: uppercase; border-bottom: 3px solid #FFD400; padding-bottom: 10px; display: inline-block; margin: 0;">
            Danh sách Đơn Hàng
        </h2>
    </div>

    <div class="table-responsive" style="box-shadow: 0 0 15px rgba(0,0,0,0.1); border-radius: 8px; overflow: hidden; background-color: white;">
        <table class="table table-bordered table-hover mb-0">
            <thead style="background-color: #FFD400; color: #141414;">
                <tr>
                    <th style="text-align: center; width: 10%;">Mã Đơn</th>
                    <th style="width: 25%;">Khách Hàng</th>
                    <th style="width: 20%;">Ngày Đặt</th>
                    <th style="width: 15%;">Tổng Tiền</th>
                    <th style="width: 15%;">Thanh toán</th>
                    <th style="text-align: center; width: 15%;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Orders != null && Model.Orders.Any())
                {
                    foreach (var item in Model.Orders)
                    {
                        <tr>
                            <td style="text-align: center; font-weight: bold; vertical-align: middle;">#@item.OrderID</td>
                            <td style="vertical-align: middle;">@(item.Customer != null ? item.Customer.CustomerName : "Khách vãng lai")</td>
                            <td style="vertical-align: middle;">@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td style="color: #E3000B; font-weight: bold; vertical-align: middle;">
                                @String.Format("{0:N0} USD", item.TotalAmount)
                            </td>
                            <td style="vertical-align: middle;">@item.PaymentMethod</td>
                            <td style="text-align: center; vertical-align: middle;">
                                <!-- Chỉ hiển thị nút xem chi tiết, không có sửa/xóa theo checklist -->
                                <a href="@Url.Action("Detail", new { id = item.OrderID })" class="btn btn-sm btn-primary" style="border-radius: 4px;">
                                    <i class="fa-solid fa-eye"></i> Xem chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align: center; color: gray; padding: 20px;">Chưa có đơn hàng nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

  
</div>