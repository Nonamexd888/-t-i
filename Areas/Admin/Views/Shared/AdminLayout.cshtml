@{
    // Menu của trang hiện tại sẽ sáng lên (gạch đen dưới chân chữ)
    var currentController = Convert.ToString(ViewContext.RouteData.Values["controller"]);
    Func<string, string> navClass = c =>
        "header-toolbar" + (string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase) ? " active" : "");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link href="~/Content/Site.css" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 90px; /* chừa chỗ cho header dính phía trên */
        }

        body, html {
            height: 100%;
            font-family: Arial,'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
        }

        ::selection {
            background: #FFD400;
            color: #000;
        }

        /* ================= KHUNG TRANG ================= */
        .page-grid {
            display: grid;
            background-color: grey;
            grid-template-areas:
                "header"
                "content"
                "footer";
            grid-template-columns: minmax(0, 1fr); /* để bảng rộng tự có thanh cuộn thay vì làm tràn trang */
            grid-template-rows: auto 1fr auto; /* nội dung giãn ra, footer luôn nằm dưới cùng */
            min-height: 100vh;
            gap: 0;
        }

        .header {
            grid-area: header;
            position: sticky; /* cuộn trang xuống vẫn thấy menu */
            top: 0;
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: clamp(16px, 3vw, 70px);
            height: 75px;
            padding: 0 35px;
            background-color: #FFD400;
            border-bottom: 4px solid #E3000B; /* vạch đỏ LEGO */
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
        }

        .back_home {
            border: none;
            cursor: pointer;
            display: inline-flex;
            background-color: transparent;
        }

            .back_home img {
                transition: transform 0.3s ease;
            }

            .back_home:hover img {
                transform: rotate(-6deg) scale(1.08);
            }

        .header-toolbar {
            position: relative;
            align-self: stretch;
            display: inline-flex;
            align-items: center;
            padding: 0 14px;
            color: #141414;
            text-decoration: none;
            font-weight: bold;
            font-size: 20px;
            border-radius: 10px 10px 0 0;
            transition: background-color 0.25s ease;
        }

            .header-toolbar::after {
                content: "";
                position: absolute;
                left: 10px;
                right: 10px;
                bottom: 0;
                height: 5px;
                background-color: #141414;
                border-radius: 5px 5px 0 0;
                transform: scaleX(0);
                transform-origin: center;
                transition: transform 0.25s ease;
            }

            .header-toolbar:hover {
                color: #141414;
                text-decoration: none;
                background-color: rgba(255, 255, 255, 0.35);
            }

                .header-toolbar:hover::after,
                .header-toolbar.active::after {
                    transform: scaleX(1);
                }

            .header-toolbar:focus-visible {
                outline: 3px solid #0055BF;
                outline-offset: -3px;
            }

        .head-icon {
            margin-left: auto; /* đẩy sang mép phải */
            align-self: center;
            padding: 6px 18px;
            color: #141414;
            font-size: 17px;
            font-weight: bold;
            border: 2px solid #141414;
            border-radius: 999px;
            transition: all 0.25s ease;
        }

            .head-icon:hover {
                color: #fff;
                background-color: #E3000B;
                border-color: #E3000B;
                cursor: pointer;
                transform: translateY(-2px);
                box-shadow: 0 6px 14px rgba(0, 0, 0, 0.25);
            }

            .head-icon a,
            .head-icon a:hover {
                display: flex;
                align-items: center;
                gap: 8px;
                text-decoration: none; /*Bỏ gạch chân*/
                color: inherit;
            }

            .head-icon img {
                width: 26px;
                height: 26px;
                object-fit: contain; /*Chỉnh ảnh vừa khung*/
                transition: filter 0.25s ease;
            }

        .wave-text span {
            display: inline-block;
        }

        .head-icon:hover .wave-text span {
            animation: wave 1.25s ease-in-out infinite;
            animation-delay: calc(var(--i) * 0.06s); /* mỗi chữ trễ hơn chữ trước 0.06s */
        }

        @@keyframes wave {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-6px);
            }
        }

        @@media (max-width: 1100px) {
            .header {
                padding: 0 16px;
            }

            .header-toolbar {
                font-size: 16px;
                padding: 0 8px;
            }

            .head-icon {
                font-size: 15px;
                padding: 4px 12px;
            }
        }

        .content {
            grid-area: content;
            position: relative;
            min-width: 0;
            background-color: white;
        }

        .btn {
            transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.2s ease, color 0.2s ease;
        }

            .btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            }

            .btn:active {
                transform: translateY(0);
                box-shadow: none;
            }

        .footer {
            grid-area: footer;
            position: relative;
            background-color: #141414;
            color: white;
            padding: 56px 20px 50px;
        }

            .footer::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 6px;
                background: linear-gradient(90deg, #E3000B 0%, #E3000B 25%, #FFD400 25%, #FFD400 50%, #0055BF 50%, #0055BF 75%, #00A651 75%, #00A651 100%);
            }

        .footer_inner {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 40px 80px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .footer_logo img {
            width: 120px;
            height: 120px;
            border-radius: 8px;
            transition: transform 0.3s ease;
        }

            .footer_logo img:hover {
                transform: scale(1.06) rotate(-3deg);
            }

        .footer_col {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

            .footer_col h3 {
                position: relative;
                margin: 0 0 10px 0;
                padding-bottom: 12px;
                font-size: 24px;
            }

                .footer_col h3::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: 0;
                    width: 40px;
                    height: 3px;
                    border-radius: 2px;
                    background-color: #FFD400;
                    transition: width 0.3s ease;
                }

            .footer_col:hover h3::after {
                width: 90px;
            }

            .footer_col a {
                display: inline-block;
                align-self: flex-start;
                color: white;
                text-decoration: none;
                font-size: 16px;
                transition: color 0.2s ease, transform 0.2s ease;
            }

                .footer_col a:hover {
                    color: #FFD400;
                    text-decoration: none;
                    transform: translateX(6px);
                }

        .search-box-lego {
            display: flex;
            align-items: center;
            background-color: white;
            border: 1px solid #d9d9d9;
            border-radius: 25px;
            padding: 6px 16px;
            width: 280px;
            height: 38px;
            box-sizing: border-box;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

            .search-box-lego:focus-within,
            .search-box-lego:hover {
                border-color: #0045B7;
                box-shadow: 0 0 0 1px #0045B7;
            }

            .search-box-lego i {
                font-size: 16px;
                color: #000000;
                margin-right: 10px;
            }

            .search-box-lego input {
                border: none;
                outline: none;
                background: transparent;
                width: 100%;
                font-size: 15px;
                color: #2c2c2c;
            }
    </style>
</head>
<body>
    <div class="page-grid">
        <div class="header">
            <a class="back_home" href="@Url.Action("Home_page","Home")" title="Trang chủ">
                <img src="~/Content/Content_Shopping_stalls/Img_Page1/Hình logo LEGO.svg" width="55" height="55" alt="LEGO" />
            </a>

            @* Các mục chưa có trang: dùng link "#" (trước đây ActionLink("#","#") sinh ra đường dẫn sai) *@
            <a href="#" class="header-toolbar">Home</a>
            @Html.ActionLink("Danh mục", "Index", "Categories", null, new { @class = navClass("Categories") })
            @Html.ActionLink("Sản phẩm", "Index", "Products", null, new { @class = navClass("Products") })
            <a href="#" class="header-toolbar">Khách hàng</a>
            <a href="#" class="header-toolbar">Đơn hàng</a>
            <a href="#" class="header-toolbar">Tài khoản</a>

            <div class="head-icon">
                <a href="@Url.Action("Dangnhap", "Sign", new { area = "" })">
                    <img src="~/Content/Content_Shopping_stalls/Img_Page1/Hình đầu lego.svg" alt="Sign In" />
                    <span class="wave-text">Sign Up Admin</span>
                </a>
            </div>
        </div>
        <div class="content">@RenderBody()</div>
        @if (IsSectionDefined("footer"))
        {
            @RenderSection("footer", required: false)
        }
        else
        {
            <div class="footer">
                <div class="footer_inner">
                    <div class="footer_col footer_logo">
                        <img src="~/Content/Img_HomePage/LEGO_logo.jpg" alt="LEGO" />
                    </div>
                    <div class="footer_col">
                        <h3>ABOUT US</h3>
                        <a href="#">Nguyễn Gia Bảo</a>
                        <a href="#">Nguyễn Hồng Ngọc Nghĩa</a>
                        <a href="#">Nguyễn Hồng Ngọc Nghĩa</a>
                    </div>

                    <div class="footer_col">
                        <h3>SUPPORT</h3>
                        <a href="#">Claude</a>
                        <a href="#">DeepSeek</a>
                        <a href="#">Gemini bản free</a>
                    </div>
                </div>
            </div>
        }
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script>
        document.querySelectorAll('.wave-text').forEach(function (el) {
            var text = el.textContent.trim();
            el.setAttribute('aria-label', text);
            el.innerHTML = Array.from(text).map(function (ch, i) {
                return '<span aria-hidden="true" style="--i:' + i + '">' + (ch === ' ' ? '&nbsp;' : ch) + '</span>';
            }).join('');
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>