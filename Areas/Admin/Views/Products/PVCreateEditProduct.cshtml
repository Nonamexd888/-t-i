@model Đề_tài.Models.Product

<style>
    /* Mỗi dòng: nhãn bên trái, ô nhập bên phải (không phụ thuộc lưới Bootstrap) */
    .form-row-lego {
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 8px 24px;
        align-items: start;
        margin-bottom: 20px;
    }

    .form-label-lego {
        margin: 0;
        padding-top: 8px;
        font-weight: 700;
        color: #1A1A1A;
    }

    @@media (max-width: 768px) {
        .form-row-lego {
            grid-template-columns: 1fr;
        }

        .form-label-lego {
            padding-top: 0;
        }
    }

    /* Ô mô tả: chỉ áp dụng cho form này, kéo giãn được theo chiều dọc */
    .form-card textarea.form-control {
        min-height: 150px;
        resize: vertical;
    }

    /* Ô chọn file ảnh */
    .form-card input[type="file"] {
        width: 100%;
        max-width: 400px;
        padding: 6px;
        border: 1px dashed #aaa;
        border-radius: 8px;
        background-color: #fafafa;
        cursor: pointer;
    }

        .form-card input[type="file"]::file-selector-button {
            background-color: #FFD400; /* vàng LEGO cho hợp header */
            color: black;
            border: none;
            border-radius: 6px;
            padding: 8px 16px;
            margin-right: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

            .form-card input[type="file"]::file-selector-button:hover {
                background-color: #E60101; /* đỏ khi rê chuột, giống menu */
                color: white;
            }

    .field-note {
        margin: 8px 0 0 0;
        color: #555;
        font-size: 14px;
        word-break: break-all;
    }

    .field-note-label {
        margin-right: 6px;
        font-weight: 700;
    }
</style>

<div class="form-row-lego">
    @Html.LabelFor(model => model.CategoryID, "Danh mục", htmlAttributes: new { @class = "form-label-lego" })
    <div>
        @Html.DropDownList("CategoryID", null, htmlAttributes: new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.CategoryID, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-row-lego">
    @Html.LabelFor(model => model.ProductName, "Tên sản phẩm", htmlAttributes: new { @class = "form-label-lego" })
    <div>
        @Html.EditorFor(model => model.ProductName, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-row-lego">
    @Html.LabelFor(model => model.ProductDescription, "Mô tả sản phẩm", htmlAttributes: new { @class = "form-label-lego" })
    <div>
        @* Sửa lỗi cũ: TextAreaFor nhận thuộc tính HTML trực tiếp, không bọc trong htmlAttributes = new {...} *@
        @Html.TextAreaFor(model => model.ProductDescription, new { @class = "form-control", rows = 6 })
        @Html.ValidationMessageFor(model => model.ProductDescription, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-row-lego">
    @Html.LabelFor(model => model.ProductPrice, "Giá sản phẩm", htmlAttributes: new { @class = "form-label-lego" })
    <div>
        @Html.EditorFor(model => model.ProductPrice, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.ProductPrice, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-row-lego">
    @Html.LabelFor(model => model.ProductImage, "Hình ảnh", htmlAttributes: new { @class = "form-label-lego" })
    <div>
        <input type="file" name="UploadImg" class="form-control" />
        <p class="field-note"><span class="field-note-label">Đường dẫn hiện tại:</span>@Html.DisplayFor(p => p.ProductImage)</p>
        @Html.ValidationMessageFor(model => model.ProductImage, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-row-lego">
    @Html.LabelFor(model => model.ProductMinAge, "Tuổi tối thiểu", htmlAttributes: new { @class = "form-label-lego" })
    <div>
        @Html.EditorFor(model => model.ProductMinAge, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.ProductMinAge, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-row-lego">
    @Html.LabelFor(model => model.ProductStock, "Số lượng trong kho", htmlAttributes: new { @class = "form-label-lego" })
    <div>
        @Html.EditorFor(model => model.ProductStock, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.ProductStock, "", new { @class = "text-danger" })
    </div>
</div>